+import { ICommandService } from '../../../../platform/commands/common/commands.js';
+import { IConfigurationService } from '../../../../platform/configuration/common/configuration.js';
+
+/**
+ * The Jesutobits popups' shared shell, from the Studio design: VS Code's onboarding modal
+ * (`onboarding-a-*` styles, focus trap, Escape) laid out in two columns. The left column has
+ * the brand, a headline and the list of pages; the right one the page with a header, and a
+ * footer with Back, progress dots and the main button. The welcome popup and the account
+ * popup are built on it.
+ */
+
+/** The Jesutobits extension's commands the popups use (apps/vscode-extension in the jesutobits repository). */
+export const JesutobitsCommand = {
+	HasApiKey: 'jesutobits.hasApiKey',
+	ConnectOpenRouter: 'jesutobits.connectOpenRouter',
+	SetApiKey: 'jesutobits.setApiKey',
+	SignOut: 'jesutobits.signOut',
+	UseFreeModel: 'jesutobits.useFreeModel',
+	ChooseModel: 'jesutobits.chooseModel',
+	Compose: 'jesutobits.compose',
+	OpenAgent: 'jesutobits.openAgent',
+	StudioView: 'jesutobits.studio.focus',
+	Profile: 'jesutobits.profile',
+	Account: 'jesutobits.account',
+	ChoosePicture: 'jesutobits.chooseProfilePicture',
+	RemovePicture: 'jesutobits.removeProfilePicture',
+} as const;
+
+export const MODEL_SETTING = 'jesutobits.providers.openrouter.defaultModel';
+/** What `jesutobits.useFreeModel` sets (FREE_CODING_MODEL in the extension). */
