+import { $, append, addDisposableListener, clearNode, EventType } from '../../../../base/browser/dom.js';
+import { BaseActionViewItem, IBaseActionViewItemOptions } from '../../../../base/browser/ui/actionbar/actionViewItems.js';
+import { IAction } from '../../../../base/common/actions.js';
+import { Codicon } from '../../../../base/common/codicons.js';
+import { Disposable } from '../../../../base/common/lifecycle.js';
+import { URI } from '../../../../base/common/uri.js';
+import { localize, localize2 } from '../../../../nls.js';
+import { IAccessibilityService } from '../../../../platform/accessibility/common/accessibility.js';
+import { IActionViewItemService } from '../../../../platform/actions/browser/actionViewItemService.js';
+import { Action2, MenuId, registerAction2 } from '../../../../platform/actions/common/actions.js';
+import { ICommandService } from '../../../../platform/commands/common/commands.js';
+import { ConfigurationTarget, IConfigurationService } from '../../../../platform/configuration/common/configuration.js';
+import { IContextKeyService } from '../../../../platform/contextkey/common/contextkey.js';
+import { InstantiationType, registerSingleton } from '../../../../platform/instantiation/common/extensions.js';
+import { createDecorator, ServicesAccessor } from '../../../../platform/instantiation/common/instantiation.js';
+import { ILayoutService } from '../../../../platform/layout/browser/layoutService.js';
+import { IOpenerService } from '../../../../platform/opener/common/opener.js';
+import { IWorkbenchContribution, registerWorkbenchContribution2, WorkbenchPhase } from '../../../common/contributions.js';
+import { EXPERIENCE_SETTING, IModalCopy, IModalPage, IRadioChoice, JesutobitsCommand, JesutobitsModal, openRouterMark, PRESET_SETTING } from './jesutobitsModal.js';
+import { EXPERIENCES, PRESETS } from './jesutobitsOnboarding.js';
+
+/**
+ * Jesutobits: the user's avatar in the title bar and the account popup it opens (patch 006).
+ * Jesutobits has no accounts of its own: the profile is a name and a picture kept on this
+ * computer by the extension, and the account is the user's OpenRouter connection. The popup
+ * only ever learns whether a key is stored and what OpenRouter says about it, never the key.
+ */
+
+const NAME_SETTING = 'jesutobits.profile.name';
+const DATA_COLLECTION_SETTING = 'jesutobits.providers.openrouter.dataCollection';
+const ACCOUNT_ACTION_ID = 'jesutobits.titleBar.account';
+/** Context keys the extension sets, so the avatar knows to draw itself again. */
+const PROFILE_KEYS = new Set(['jesutobits.connected', 'jesutobits.profileRevision']);
+/** Only pictures the extension made: an image `data:` URL. */
+const PICTURE_URL = /^data:image\/(?:png|jpeg|gif|webp);base64,[A-Za-z0-9+/]+=*$/;
+
+interface IProfile {
+	readonly name: string;
+	readonly picture: string | null;
+	readonly connected: boolean;
+}
+
+interface IAccountInfo extends IProfile {
+	readonly account?: {
+		readonly label: string | null;
+		readonly usageUsd: number | null;
+		readonly limitUsd: number | null;
+		readonly remainingUsd: number | null;
+		readonly freeTier: boolean;
+		readonly freeRequests: { readonly used: number; readonly limit: number } | null;
+	};
+	readonly problem?: string;
+}
+
+const NO_PROFILE: IProfile = { name: '', picture: null, connected: false };
+
+const PRIVACY: readonly IRadioChoice[] = [
+	{ id: 'deny', label: localize('jt.account.private', "Keep my prompts private"), description: localize('jt.account.private.desc', "Only providers that do not keep or learn from prompts. Free models will not work.") },
+	{ id: 'allow', label: localize('jt.account.allow', "Allow free models"), description: localize('jt.account.allow.desc', "Providers may keep prompts or learn from them. Free models need this.") },
+];
+
+/** The user's picture, or their initial, with a dot that is green while OpenRouter is connected. */
+function renderAvatar(container: HTMLElement, profile: IProfile, size: number): HTMLElement {
+	const avatar = append(container, $('span.jesutobits-avatar'));
+	avatar.style.width = avatar.style.height = `${size}px`;
+	avatar.style.fontSize = `${Math.round(size * 0.45)}px`;
+	avatar.setAttribute('aria-hidden', 'true');
+	if (profile.picture && PICTURE_URL.test(profile.picture)) {
+		const img = append(avatar, $<HTMLImageElement>('img'));
+		img.src = profile.picture;
+		img.alt = '';
+	} else if (profile.name) {
+		avatar.textContent = [...profile.name.trim()][0]?.toUpperCase() ?? '';
+	} else {
+		avatar.appendChild($('span.codicon.codicon-account'));
+	}
+	append(avatar, $('span.jesutobits-avatar-dot')).classList.toggle('connected', profile.connected);
+	return avatar;
+}
+
+function money(value: number): string {
+	return `$${value < 10 ? value.toFixed(2) : value.toFixed(0)}`;
+}
+
+export const IJesutobitsAccountService = createDecorator<IJesutobitsAccountService>('jesutobitsAccountService');
+
+export interface IJesutobitsAccountService {
+	readonly _serviceBrand: undefined;
+	show(): void;
+}
+
+export class JesutobitsAccount extends JesutobitsModal implements IJesutobitsAccountService {
+
+	declare readonly _serviceBrand: undefined;
+
+	private profile: IProfile = NO_PROFILE;
+	private info: IAccountInfo | undefined;
+	private checking = false;
+
+	constructor(
+		@ILayoutService layoutService: ILayoutService,
+		@IConfigurationService configurationService: IConfigurationService,
+		@ICommandService commandService: ICommandService,
+		@IAccessibilityService accessibilityService: IAccessibilityService,
+		@IOpenerService private readonly openerService: IOpenerService,
+	) {
+		super(layoutService, accessibilityService, commandService, configurationService);
+	}
+
+	override show(): void {
+		if (this.isOpen) {
+			return;
+		}
+		super.show();
+		void this.load();
+	}
+
+	/** The profile, then (when connected) what OpenRouter says about the key. */
+	private async load(): Promise<void> {
+		this.profile = (await this.query<IProfile>(JesutobitsCommand.Profile)) ?? NO_PROFILE;
+		this.info = undefined;
+		this.checking = this.profile.connected;
+		this.renderHeroAgain();
+		// Every page may show the profile; draw the open one again now that it is known.
+		if (this.isOpen) {
+			this.renderPage();
+			this.focusPage();
+		}
+		if (this.profile.connected) {
+			this.info = await this.query<IAccountInfo>(JesutobitsCommand.Account);
+			this.checking = false;
+			this.redrawOpenRouterPage();
+		}
+	}
+
+	/** An extension command answering data; no prompt, so the popup stays where it is. */
+	private async query<T>(command: string): Promise<T | undefined> {
+		try {
+			return await this.commandService.executeCommand<T>(command);
+		} catch {
+			return undefined;
+		}
+	}
+
+	private redrawOpenRouterPage(): void {
+		if (this.isOpen && this.pageIndex === 1) {
+			this.renderPage();
+		}
+	}
+
+	protected copy(): IModalCopy {
+		return {
+			className: 'jesutobits-account',
+			ariaLabel: localize('jt.account.aria', "Your account"),
+			header: localize('jt.account.header', "Your account"),
+			close: localize('jt.account.close', "Close"),
+			note: [localize('jt.account.note.one', "Your name and picture stay on this computer."), localize('jt.account.note.two', "Your key stays in the system's credential store.")],
+			freeNavigation: true,
+		};
+	}
+
+	protected renderHero(container: HTMLElement): void {
+		append(container, $('div.jesutobits-modal-eyebrow')).textContent = localize('jt.account.eyebrow', "Your account");
+		const who = append(container, $('.jesutobits-account-who'));
+		renderAvatar(who, this.profile, 64);
+		append(who, $('div.jesutobits-account-name')).textContent = this.profile.name || localize('jt.account.you', "You");
+		const status = append(who, $('div.jesutobits-account-status'));
+		append(status, $('i')).classList.toggle('connected', this.profile.connected);
+		append(status, $('span')).textContent = this.profile.connected
+			? localize('jt.account.connected', "Connected to OpenRouter")
+			: localize('jt.account.notConnected', "Not connected yet");
+	}
+
+	protected pages(): readonly IModalPage[] {
+		return [
+			{
+				label: localize('jt.account.page.profile', "Profile"),
+				title: localize('jt.account.profile.title', "This is you."),
+				subtitle: localize('jt.account.profile.subtitle', "Your name and picture show in the top bar. Jesutobits keeps them on this computer; nobody else sees them."),
+				render: container => this.renderProfile(container),
+			},
+			{
+				label: localize('jt.account.page.openrouter', "OpenRouter"),
+				title: localize('jt.account.openrouter.title', "Your OpenRouter\naccount"),
+				subtitle: localize('jt.account.openrouter.subtitle', "One account for many AI models. Your co-builder reaches the model you pick through it."),
+				render: container => this.renderOpenRouter(container),
+			},
+			{
+				label: localize('jt.account.page.model', "Model & privacy"),
+				title: localize('jt.account.model.title', "Your model and\nyour data"),
+				subtitle: localize('jt.account.model.subtitle', "Pick the model new sessions use, and what model makers may do with your prompts."),
+				render: container => this.renderModelAndPrivacy(container),
+			},
+			{
+				label: localize('jt.account.page.work', "How I work"),
+				title: localize('jt.account.work.title', "How much should I\ncheck with you?"),
+				subtitle: localize('jt.account.work.subtitle', "Your co-builder explains its steps either way. You can also change this from the status bar."),
+				render: container => {
+					this.renderRadioRows(container, PRESETS, this.configurationService.getValue<string>(PRESET_SETTING) ?? 'balanced', localize('jt.account.work.preset', "Before edits and commands"), choice => {
+						this.configurationService.updateValue(PRESET_SETTING, choice.id, ConfigurationTarget.USER);
+					});
+					this.renderRadioRows(container, EXPERIENCES, this.configurationService.getValue<string>(EXPERIENCE_SETTING) ?? undefined, localize('jt.account.work.experience', "Where are you starting from?"), choice => {
+						this.configurationService.updateValue(EXPERIENCE_SETTING, choice.id, ConfigurationTarget.USER);
+					});
+				},
+			},
+		];
+	}
+
+	protected primaryLabel(): string {
+		return localize('jt.account.done', "Done");
+	}
+
+	protected finish(): void {
+		this.dismiss();
+	}
+
+	protected override renderFooterStart(container: HTMLElement): void {
+		const all = append(container, $<HTMLButtonElement>('button.jesutobits-onboarding-link'));
+		all.type = 'button';
+		all.textContent = localize('jt.account.allSettings', "All settings");
+		this.registerChrome(all);
+		this.chromeDisposables.add(addDisposableListener(all, EventType.CLICK, () => {
+			this.dismiss();
+			void this.commandService.executeCommand('workbench.action.openSettings', 'jesutobits');
+		}));
+	}
+
+	// Profile
+
+	private renderProfile(container: HTMLElement): void {
+		const row = append(container, $('.jesutobits-account-picture'));
+		renderAvatar(row, this.profile, 72);
+		const buttons = append(row, $('.jesutobits-onboarding-row'));
+		const choose = this.registerFocusable(append(buttons, $<HTMLButtonElement>('button.onboarding-a-btn.onboarding-a-btn-secondary')));
+		choose.type = 'button';
+		choose.textContent = this.profile.picture
+			? localize('jt.account.changePicture', "Change picture")
+			: localize('jt.account.choosePicture', "Choose a picture");
+		this.pageDisposables.add(addDisposableListener(choose, EventType.CLICK, async () => {
+			await this.runExtensionCommand(() => this.commandService.executeCommand(JesutobitsCommand.ChoosePicture));
+			await this.load();
+			this.renderPage();
+		}));
+		if (this.profile.picture) {
+			const remove = this.registerFocusable(append(buttons, $<HTMLButtonElement>('button.jesutobits-onboarding-link')));
+			remove.type = 'button';
+			remove.textContent = localize('jt.account.removePicture', "Remove");
+			this.pageDisposables.add(addDisposableListener(remove, EventType.CLICK, async () => {
+				await this.runExtensionCommand(() => this.commandService.executeCommand(JesutobitsCommand.RemovePicture));
+				await this.load();
+				this.renderPage();
+			}));
+		}
+
+		const label = append(container, $<HTMLLabelElement>('label.jesutobits-modal-label'));
+		label.textContent = localize('jt.account.nameLabel', "What should I call you?");
+		label.htmlFor = 'jesutobits-account-name';
+		const field = this.registerFocusable(append(container, $<HTMLInputElement>('input.jesutobits-account-input')));
+		field.id = 'jesutobits-account-name';
+		field.maxLength = 60;
+		field.value = this.configurationService.getValue<string>(NAME_SETTING) ?? '';
+		field.placeholder = this.profile.name;
+		const save = async () => {
+			const name = field.value.trim();
+			if (name === (this.configurationService.getValue<string>(NAME_SETTING) ?? '')) {
+				return;
+			}
+			await this.configurationService.updateValue(NAME_SETTING, name, ConfigurationTarget.USER);
+			this.profile = (await this.query<IProfile>(JesutobitsCommand.Profile)) ?? this.profile;
+			this.renderHeroAgain();
+		};
+		this.pageDisposables.add(addDisposableListener(field, EventType.BLUR, () => void save()));
+		this.pageDisposables.add(addDisposableListener(field, EventType.KEY_DOWN, (e: KeyboardEvent) => {
+			if (e.key === 'Enter') {
+				e.preventDefault();
+				void save();
+			}
+		}));
+		append(container, $('div.jesutobits-modal-hint')).textContent = localize('jt.account.nameHint', "Leave it empty to use your computer's user name.");
+	}
+
+	// OpenRouter
+
+	private renderOpenRouter(container: HTMLElement): void {
+		if (!this.profile.connected) {
+			this.renderConnect(container, () => void this.load());
+			return;
+		}
+		const panel = append(container, $('.jesutobits-onboarding-panel'));
+		const heading = append(panel, $('div.jesutobits-onboarding-panel-title'));
+		heading.appendChild(openRouterMark(heading.ownerDocument, 14));
+		append(heading, $('span')).textContent = localize('jt.account.connectedTitle', "Connected to OpenRouter");
+
+		const facts = append(panel, $('dl.jesutobits-account-facts'));
+		const fact = (term: string, value: string) => {
+			append(facts, $('dt')).textContent = term;
+			append(facts, $('dd')).textContent = value;
+		};
+		const account = this.info?.account;
+		if (this.checking) {
+			append(panel, $('div.jesutobits-onboarding-status')).textContent = localize('jt.account.checking', "Checking your account…");
+		} else if (!account) {
+			append(panel, $('div.jesutobits-onboarding-status')).textContent = this.info?.problem ?? localize('jt.account.noInfo', "OpenRouter did not say more about this key.");
+		} else {
+			fact(localize('jt.account.key', "Key"), account.label ?? localize('jt.account.unnamed', "Unnamed"));
+			fact(localize('jt.account.plan', "Plan"), account.freeTier
+				? localize('jt.account.freeTier', "Free (no credits bought yet)")
+				: localize('jt.account.paid', "Credits"));
+			if (account.usageUsd !== null) {
+				fact(localize('jt.account.spent', "Spent with this key"), money(account.usageUsd));
+			}
+			fact(localize('jt.account.limit', "Spending limit"), account.limitUsd === null
+				? localize('jt.account.noLimit', "No limit")
+				: localize('jt.account.left', "{0} left of {1}", money(account.remainingUsd ?? 0), money(account.limitUsd)));
+			if (account.freeRequests) {
+				fact(localize('jt.account.freeToday', "Free-model requests today"), localize('jt.account.freeUsed', "{0} of {1}", account.freeRequests.used, account.freeRequests.limit));
+			}
+		}
+
+		const row = append(panel, $('.jesutobits-onboarding-row'));
+		const link = (label: string, url: string, primary = false) => {
+			const button = this.registerFocusable(append(row, $<HTMLButtonElement>(`button.onboarding-a-btn.${primary ? 'onboarding-a-btn-primary' : 'onboarding-a-btn-secondary'}`)));
+			button.type = 'button';
+			button.textContent = label;
+			this.pageDisposables.add(addDisposableListener(button, EventType.CLICK, () => {
+				void this.openerService.open(URI.parse(url), { openExternal: true });
+			}));
+		};
+		link(localize('jt.account.credits', "Add credits"), 'https://openrouter.ai/settings/credits', !!account?.freeTier);
+		link(localize('jt.account.keys', "Manage keys"), 'https://openrouter.ai/settings/keys');
+		const signOut = this.registerFocusable(append(row, $<HTMLButtonElement>('button.jesutobits-onboarding-link.danger')));
+		signOut.type = 'button';
+		signOut.textContent = localize('jt.account.signOut', "Sign out");
+		this.pageDisposables.add(addDisposableListener(signOut, EventType.CLICK, async () => {
+			await this.runExtensionCommand(() => this.commandService.executeCommand(JesutobitsCommand.SignOut));
+			await this.load();
+			this.renderPage();
+		}));
+	}
+
+	// Model and privacy
+
+	private renderModelAndPrivacy(container: HTMLElement): void {
+		this.renderModel(container, async () => this.profile.connected);
+		this.renderRadioRows(container, PRIVACY, this.configurationService.getValue<string>(DATA_COLLECTION_SETTING) ?? 'deny', localize('jt.account.privacy', "What model makers may do with your prompts"), choice => {
+			this.configurationService.updateValue(DATA_COLLECTION_SETTING, choice.id, ConfigurationTarget.USER);
+		});
+	}
+}
+
+registerSingleton(IJesutobitsAccountService, JesutobitsAccount, InstantiationType.Delayed);
+
+/** The avatar in the title bar: the user's picture or initial; a click opens the account popup. */
+class JesutobitsAvatarViewItem extends BaseActionViewItem {
+
+	private generation = 0;
+
+	constructor(
+		action: IAction,
+		options: IBaseActionViewItemOptions,
+		@ICommandService private readonly commandService: ICommandService,
+		@IContextKeyService contextKeyService: IContextKeyService,
+		@IConfigurationService configurationService: IConfigurationService,
+	) {
+		super(undefined, action, options);
+		this._register(contextKeyService.onDidChangeContext(e => {
+			if (e.affectsSome(PROFILE_KEYS)) {
+				void this.draw();
+			}
+		}));
+		this._register(configurationService.onDidChangeConfiguration(e => {
+			if (e.affectsConfiguration(NAME_SETTING)) {
+				void this.draw();
+			}
+		}));
+	}
+
+	override render(container: HTMLElement): void {
+		super.render(container);
+		container.classList.add('jesutobits-avatar-item');
+		container.setAttribute('role', 'button');
+		container.tabIndex = 0;
+		void this.draw();
+	}
+
+	private async draw(): Promise<void> {
+		const generation = ++this.generation;
+		let profile: IProfile | undefined;
+		try {
+			profile = await this.commandService.executeCommand<IProfile>(JesutobitsCommand.Profile);
+		} catch {
+			// The extension has not started yet; its context keys draw the avatar again later.
+		}
+		const element = this.element;
+		if (!element || generation !== this.generation) {
+			return;
+		}
+		clearNode(element);
+		renderAvatar(element, profile ?? NO_PROFILE, 24);
+		const label = profile
+			? profile.connected
+				? localize('jt.avatar.connected', "{0} · Connected to OpenRouter", profile.name)
+				: localize('jt.avatar.notConnected', "{0} · Not connected to OpenRouter", profile.name)
+			: localize('jt.avatar.account', "Your account");
+		element.title = label;
+		element.setAttribute('aria-label', label);
+	}
+}
+
+registerAction2(class extends Action2 {
+	constructor() {
+		super({
+			id: ACCOUNT_ACTION_ID,
+			title: localize2('jesutobits.titleBar.account', "Your Account"),
+			icon: Codicon.account,
+			menu: { id: MenuId.TitleBar, group: 'navigation', order: 1000 },
+		});
+	}
+
+	run(accessor: ServicesAccessor): void {
+		accessor.get(IJesutobitsAccountService).show();
+	}
+});
+
+class JesutobitsAvatarContribution extends Disposable implements IWorkbenchContribution {
+
+	static readonly ID = 'workbench.contrib.jesutobitsAvatar';
+
+	constructor(@IActionViewItemService actionViewItemService: IActionViewItemService) {
+		super();
+		this._register(actionViewItemService.register(MenuId.TitleBar, ACCOUNT_ACTION_ID, (action, options, instantiationService) =>
+			instantiationService.createInstance(JesutobitsAvatarViewItem, action, options)));
+	}
+}
+
+registerWorkbenchContribution2(JesutobitsAvatarContribution.ID, JesutobitsAvatarContribution, WorkbenchPhase.BlockStartup);
