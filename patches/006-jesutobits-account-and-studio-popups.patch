+	private backButton: HTMLButtonElement | undefined;
+	private primaryButton: HTMLButtonElement | undefined;
+	private closeButton: HTMLButtonElement | undefined;
+
+	protected pageIndex = 0;
+	/** Lives while the popup is open: its frame's listeners. */
+	protected readonly chromeDisposables = this._register(new DisposableStore());
