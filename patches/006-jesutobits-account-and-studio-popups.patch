+	// Pieces the pages share.
+
+	/** A radio group of rows (a circle, a title, a line of description), as in the design. */
+	protected renderRadioRows(container: HTMLElement, choices: readonly IRadioChoice[], selectedId: string | undefined, label: string, onChoose: (choice: IRadioChoice) => void): void {
+		append(container, $('div.jesutobits-modal-label')).textContent = label;
+		const group = append(container, $('.jesutobits-radio-rows'));
+		group.setAttribute('role', 'radiogroup');
+		group.setAttribute('aria-label', label);
+		const rows: HTMLButtonElement[] = [];
+		for (const choice of choices) {
+			const row = this.registerFocusable(append(group, $<HTMLButtonElement>('button.jesutobits-radio-row')));
+			row.type = 'button';
+			row.setAttribute('role', 'radio');
+			const selected = choice.id === selectedId;
+			row.classList.toggle('selected', selected);
+			row.setAttribute('aria-checked', String(selected));
+			rows.push(row);
+			append(row, $('span.jesutobits-radio')).setAttribute('aria-hidden', 'true');
+			const text = append(row, $('span.jesutobits-radio-text'));
+			append(text, $('span.jesutobits-radio-title')).textContent = choice.label;
+			append(text, $('span.jesutobits-radio-desc')).textContent = choice.description;
+			this.pageDisposables.add(addDisposableListener(row, EventType.CLICK, () => {
+				for (const r of rows) {
+					r.classList.toggle('selected', r === row);
+					r.setAttribute('aria-checked', String(r === row));
+				}
+				onChoose(choice);
+				this.accessibilityService.alert(localize('jt.choice.selected', "{0} selected", choice.label));
+			}));
+		}
+		this.setupRadioGroupNavigation(rows, Math.max(0, choices.findIndex(c => c.id === selectedId)));
+	}
+
