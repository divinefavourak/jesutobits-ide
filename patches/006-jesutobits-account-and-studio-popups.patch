+
+	constructor(
+		private readonly layoutService: ILayoutService,
+		protected readonly accessibilityService: IAccessibilityService,
+		protected readonly commandService: ICommandService,
+		protected readonly configurationService: IConfigurationService,
+	) {
+		super();
+	}
+
+	protected abstract copy(): IModalCopy;
+	protected abstract pages(): readonly IModalPage[];
+	/** The left column under the brand: a headline (welcome) or the user (account). */
+	protected abstract renderHero(container: HTMLElement): void;
+	protected abstract primaryLabel(index: number): string;
+	/** The main button on the last page (or on every page with free navigation). */
+	protected abstract finish(): Promise<void> | void;
+	/** After the popup has gone. */
+	protected onDismissed(): void { }
+	/** Something to the left of the footer's dots (the account's "All settings"). */
+	protected renderFooterStart(_container: HTMLElement): void { }
+
+	get isOpen(): boolean {
+		return this.overlay !== undefined;
+	}
+
+	show(): void {
+		if (this.overlay) {
+			return;
+		}
+		const copy = this.copy();
+		this.pageIndex = 0;
+		this.previouslyFocusedElement = getActiveWindow().document.activeElement as HTMLElement | undefined;
+
+		this.overlay = append(this.layoutService.activeContainer, $(`.onboarding-a-overlay.jesutobits-onboarding.jesutobits-modal.${copy.className}`));
+		this.overlay.setAttribute('role', 'dialog');
+		this.overlay.setAttribute('aria-modal', 'true');
+		this.overlay.setAttribute('aria-label', copy.ariaLabel);
+
+		const card = append(this.overlay, $('.onboarding-a-card.jesutobits-modal-card'));
+
+		// Left: brand, hero, the pages, small print.
+		const aside = append(card, $('aside.jesutobits-modal-aside'));
+		const brand = append(aside, $('.jesutobits-modal-brand'));
+		brand.appendChild(jMark(brand.ownerDocument, 26));
+		append(brand, $('span')).textContent = 'jesutobits';
+		this.asideHero = append(aside, $('.jesutobits-modal-hero'));
+		this.renderHero(this.asideHero);
+		this.navList = append(aside, $('ol.jesutobits-modal-nav'));
+		const note = append(aside, $('.jesutobits-modal-note'));
+		for (const line of copy.note) {
+			append(note, $('div')).textContent = line;
+		}
+
+		// Right: header, page, footer.
+		const main = append(card, $('.jesutobits-modal-main'));
+		const header = append(main, $('.jesutobits-modal-header'));
+		this.headerLabel = append(header, $('div.jesutobits-modal-eyebrow'));
+		this.closeButton = append(header, $<HTMLButtonElement>('button.jesutobits-modal-close'));
+		this.closeButton.type = 'button';
+		append(this.closeButton, $('span')).textContent = copy.close;
+		this.closeButton.appendChild(renderIcon(Codicon.close));
+		this.chromeFocusable.push(this.closeButton);
+
+		this.bodyEl = append(main, $('.onboarding-a-body.jesutobits-modal-body'));
+		this.artEl = append(this.bodyEl, $('.jesutobits-modal-art'));
+		this.titleEl = append(this.bodyEl, $('h2.onboarding-a-step-title.jesutobits-modal-title'));
+		this.subtitleEl = append(this.bodyEl, $('p.onboarding-a-step-subtitle.jesutobits-modal-subtitle'));
+		this.contentEl = append(this.bodyEl, $('.onboarding-a-step-content'));
+
+		const footer = append(main, $('.onboarding-a-footer.jesutobits-modal-footer'));
+		const footerStart = append(footer, $('.jesutobits-modal-footer-start'));
+		this.backButton = append(footerStart, $<HTMLButtonElement>('button.jesutobits-modal-back'));
+		this.backButton.type = 'button';
+		this.backButton.textContent = localize('jt.modal.back', "← Back");
+		this.chromeFocusable.push(this.backButton);
+		this.renderFooterStart(footerStart);
+		this.dotsEl = append(footer, $('.jesutobits-modal-dots'));
+		this.dotsEl.setAttribute('aria-hidden', 'true');
+		this.primaryButton = append(footer, $<HTMLButtonElement>('button.onboarding-a-btn.onboarding-a-btn-primary.jesutobits-modal-primary'));
+		this.primaryButton.type = 'button';
+		this.chromeFocusable.push(this.primaryButton);
+
+		this.chromeDisposables.add(addDisposableListener(this.closeButton, EventType.CLICK, () => this.dismiss()));
+		this.chromeDisposables.add(addDisposableListener(this.backButton, EventType.CLICK, () => this.goTo(this.pageIndex - 1)));
+		this.chromeDisposables.add(addDisposableListener(this.primaryButton, EventType.CLICK, () => {
+			if (this.copy().freeNavigation || this.pageIndex === this.pages().length - 1) {
+				void this.finish();
+			} else {
+				this.goTo(this.pageIndex + 1);
+			}
+		}));
+		this.chromeDisposables.add(addDisposableListener(this.overlay, EventType.KEY_DOWN, (e: KeyboardEvent) => {
+			const event = new StandardKeyboardEvent(e);
+			// Keep the workbench's keybindings out while the popup is open.
+			e.stopPropagation();
+			if (event.keyCode === KeyCode.Escape) {
+				e.preventDefault();
+				this.dismiss();
+			} else if (event.keyCode === KeyCode.Tab) {
+				this.trapTab(e, event.shiftKey);
+			}
+		}));
+
+		this.renderPage();
+
+		this.overlay.classList.add('entering');
+		getActiveWindow().requestAnimationFrame(() => {
+			this.overlay?.classList.remove('entering');
+			this.overlay?.classList.add('visible');
+		});
+		this.focusPage();
+	}
+
+	protected goTo(index: number): void {
+		if (index < 0 || index >= this.pages().length || !this.overlay) {
+			return;
+		}
+		this.pageIndex = index;
+		this.renderPage();
+		this.focusPage();
+	}
+
+	/** Draws the current page again (after something it shows changed). */
+	protected renderPage(): void {
+		if (!this.titleEl || !this.subtitleEl || !this.contentEl || !this.artEl) {
+			return;
+		}
+		const copy = this.copy();
+		const pages = this.pages();
+		const page = pages[this.pageIndex];
+		this.pageDisposables.clear();
+		this.pageFocusable.length = 0;
+
+		clearNode(this.artEl);
+		page.art?.(this.artEl);
+		this.artEl.style.display = page.art ? '' : 'none';
+		this.titleEl.textContent = page.title;
+		this.subtitleEl.textContent = page.subtitle;
+		clearNode(this.contentEl);
+		page.render(this.contentEl);
+
+		if (this.headerLabel) {
+			clearNode(this.headerLabel);
+			append(this.headerLabel, $('span')).textContent = `${copy.header} / `;
+			append(this.headerLabel, $('span.jesutobits-modal-count')).textContent = localize('jt.modal.count', "{0} of {1}", this.pageIndex + 1, pages.length);
+		}
+		this.renderNav(copy, pages);
+		if (this.dotsEl) {
+			clearNode(this.dotsEl);
+			for (let i = 0; i < pages.length; i++) {
+				append(this.dotsEl, $('i')).classList.toggle('active', i === this.pageIndex);
+			}
+		}
+		if (this.backButton) {
+			// With free navigation there is no Back at all; on a first step it keeps its place.
+			this.backButton.style.display = copy.freeNavigation ? 'none' : '';
+			this.backButton.style.visibility = this.pageIndex === 0 ? 'hidden' : '';
+		}
+		if (this.primaryButton) {
+			clearNode(this.primaryButton);
+			append(this.primaryButton, $('span')).textContent = this.primaryLabel(this.pageIndex);
+			this.primaryButton.appendChild(renderIcon(Codicon.arrowRight));
+		}
+		this.bodyEl?.setAttribute('aria-label', localize('jt.modal.page', "{0} of {1}: {2}", this.pageIndex + 1, pages.length, page.title));
+	}
+
+	/** Draws the left column's hero again (after the profile changed). */
+	protected renderHeroAgain(): void {
+		if (this.asideHero) {
+			clearNode(this.asideHero);
+			this.renderHero(this.asideHero);
+		}
+	}
+
+	private renderNav(copy: IModalCopy, pages: readonly IModalPage[]): void {
+		if (!this.navList) {
+			return;
+		}
+		clearNode(this.navList);
+		pages.forEach((page, i) => {
+			const item = append(this.navList!, $('li'));
+			const state = i === this.pageIndex ? 'current' : i < this.pageIndex && !copy.freeNavigation ? 'done' : 'ahead';
+			item.classList.add(state);
+			let row: HTMLElement;
+			if (copy.freeNavigation) {
+				const button = this.registerFocusable(append(item, $<HTMLButtonElement>('button.jesutobits-modal-nav-item')));
+				button.type = 'button';
+				this.pageDisposables.add(addDisposableListener(button, EventType.CLICK, () => this.goTo(i)));
+				row = button;
+			} else {
+				row = append(item, $('.jesutobits-modal-nav-item'));
+			}
+			if (i === this.pageIndex) {
+				row.setAttribute('aria-current', 'step');
+			}
+			const bullet = append(row, $('span.jesutobits-modal-nav-bullet'));
+			if (state === 'done') {
+				bullet.appendChild(renderIcon(Codicon.check));
+			} else {
+				bullet.textContent = String(i + 1);
+			}
+			append(row, $('span')).textContent = page.label;
+		});
+	}
+
+	protected dismiss(): void {
+		const overlay = this.overlay;
+		if (!overlay) {
+			return;
+		}
+		overlay.classList.remove('visible');
+		overlay.classList.add('exiting');
+		let handled = false;
+		const onTransitionEnd = () => {
+			if (handled) {
+				return;
+			}
+			handled = true;
+			this.removeFromDOM();
+			this.onDismissed();
+		};
+		overlay.addEventListener('transitionend', onTransitionEnd, { once: true });
+		setTimeout(onTransitionEnd, 400);
+	}
+
+	// OpenRouter: connecting and the model, in the welcome popup and the account popup.
+
+	/**
+	 * Sign in with OpenRouter (the browser; the extension stores the key it makes) or "I have
+	 * a key" (VS Code's password box). This popup only ever learns whether a key is stored.
+	 */
+	protected renderConnect(container: HTMLElement, onChange: () => void): { refresh(): Promise<void> } {
+		const panel = append(container, $('.jesutobits-onboarding-panel'));
+		const heading = append(panel, $('div.jesutobits-onboarding-panel-title'));
+		heading.appendChild(openRouterMark(heading.ownerDocument, 14));
+		append(heading, $('span')).textContent = localize('jt.connect.title', "Connect OpenRouter");
+		append(panel, $('p')).textContent = localize('jt.connect.desc', "OpenRouter is one account for many AI models. Sign in and allow Jesutobits: there is no key to copy, and the one OpenRouter makes is kept in your system's credential store.");
+
+		const row = append(panel, $('.jesutobits-onboarding-row'));
+		const signIn = this.registerFocusable(append(row, $<HTMLButtonElement>('button.onboarding-a-btn.onboarding-a-btn-primary.jesutobits-signin')));
+		signIn.type = 'button';
+		signIn.appendChild(openRouterMark(signIn.ownerDocument, 11));
+		const signInLabel = append(signIn, $('span'));
+		const paste = this.registerFocusable(append(row, $<HTMLButtonElement>('button.jesutobits-onboarding-link')));
+		paste.type = 'button';
+		paste.textContent = localize('jt.connect.paste', "I have a key");
+		const status = append(panel, $('div.jesutobits-onboarding-status'));
+		status.setAttribute('role', 'status');
+
+		let waiting = false;
+		const refresh = async () => {
+			const connected = await this.runExtensionCommand(() => this.commandService.executeCommand<boolean>(JesutobitsCommand.HasApiKey));
+			signInLabel.textContent = connected
+				? localize('jt.connect.again', "Sign in again")
+				: localize('jt.connect.signIn', "Sign in with OpenRouter");
+			signIn.classList.toggle('onboarding-a-btn-primary', !connected);
+			signIn.classList.toggle('onboarding-a-btn-secondary', !!connected);
+			signIn.disabled = paste.disabled = waiting;
+			status.textContent = waiting
+				? localize('jt.connect.waiting', "Finish in your browser: allow Jesutobits on openrouter.ai.")
+				: connected
+					? localize('jt.connect.stored', "Connected. Your key is stored securely.")
+					: localize('jt.connect.missing', "Not connected yet. You can do it later from the agent panel.");
+		};
+		const run = (button: HTMLButtonElement, command: string) => this.pageDisposables.add(addDisposableListener(button, EventType.CLICK, async () => {
+			waiting = command === JesutobitsCommand.ConnectOpenRouter;
+			await refresh();
+			try {
+				await this.runExtensionCommand(() => this.commandService.executeCommand(command));
+			} finally {
+				waiting = false;
+				await refresh();
+				onChange();
+				if (button.isConnected) {
+					button.focus();
+				}
+			}
+		}));
+		run(signIn, JesutobitsCommand.ConnectOpenRouter);
+		run(paste, JesutobitsCommand.SetApiKey);
+		void refresh();
+		return { refresh };
+	}
+
+	/** The default model: the free one (with what that means for the prompts) or any other. */
+	protected renderModel(container: HTMLElement, connected: () => Promise<boolean>): { refresh(): Promise<void> } {
+		const panel = append(container, $('.jesutobits-onboarding-panel'));
+		const heading = append(panel, $('div.jesutobits-onboarding-panel-title'));
+		heading.appendChild(renderIcon(Codicon.sparkle));
+		append(heading, $('span')).textContent = localize('jt.model.title', "Your model");
+		const row = append(panel, $('.jesutobits-onboarding-row'));
+		const free = this.registerFocusable(append(row, $<HTMLButtonElement>('button.onboarding-a-btn.onboarding-a-btn-secondary')));
+		free.type = 'button';
+		free.textContent = localize('jt.model.free', "Use the free model");
+		const choose = this.registerFocusable(append(row, $<HTMLButtonElement>('button.onboarding-a-btn.onboarding-a-btn-secondary')));
+		choose.type = 'button';
+		choose.textContent = localize('jt.model.choose', "Choose another");
+		append(panel, $('p.jesutobits-onboarding-note')).textContent = localize('jt.model.note', "The free model is Laguna S 2.1 by Poolside, made for coding. It is free because Poolside may learn from your prompts, so choosing it allows that. Pick a paid model to keep your prompts private.");
+		const status = append(panel, $('div.jesutobits-onboarding-status'));
+		status.setAttribute('role', 'status');
+
+		const refresh = async () => {
+			const hasKey = await connected();
+			const model = this.configurationService.getValue<string | null>(MODEL_SETTING);
+			free.disabled = choose.disabled = !hasKey;
+			free.classList.toggle('onboarding-a-btn-primary', hasKey && !model);
+			free.classList.toggle('onboarding-a-btn-secondary', !(hasKey && !model));
+			status.textContent = !hasKey
+				? localize('jt.model.needsKey', "Connect first to pick a model.")
+				: model === FREE_MODEL
+					? localize('jt.model.isFree', "Default model: Laguna S 2.1 (free).")
+					: model
+						? localize('jt.model.chosen', "Default model: {0}", model)
+						: localize('jt.model.none', "No default model yet.");
+		};
+		for (const [button, command] of [[free, JesutobitsCommand.UseFreeModel], [choose, JesutobitsCommand.ChooseModel]] as const) {
+			this.pageDisposables.add(addDisposableListener(button, EventType.CLICK, async () => {
+				await this.runExtensionCommand(() => this.commandService.executeCommand(command));
+				await refresh();
+				if (button.isConnected) {
+					button.focus();
+				}
+			}));
+		}
+		void refresh();
+		return { refresh };
+	}
+
+	protected hasKey(): Promise<boolean> {
+		return this.runExtensionCommand(() => this.commandService.executeCommand<boolean>(JesutobitsCommand.HasApiKey)).then(value => !!value);
+	}
