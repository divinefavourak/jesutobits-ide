+
+	/**
+	 * Runs one of the extension's commands. Its prompts (quick input, dialogs) sit below this
+	 * popup's layer, so the popup steps down while they are open; it still dims the workbench.
+	 */
+	protected async runExtensionCommand<T>(run: () => Promise<T | undefined>): Promise<T | undefined> {
+		this.overlay?.classList.add('jesutobits-yield');
+		try {
+			return await run();
+		} catch {
+			// The extension has not started or the command failed; its own log says why.
+			return undefined;
+		} finally {
+			this.overlay?.classList.remove('jesutobits-yield');
+		}
+	}
+
+	/** Something in the popup's frame (not the page) that takes focus, such as a footer link. */
+	protected registerChrome<T extends HTMLElement>(element: T): T {
+		this.chromeFocusable.push(element);
+		return element;
+	}
+
+	protected registerFocusable<T extends HTMLElement>(element: T): T {
+		this.pageFocusable.push(element);
+		return element;
+	}
+
+	/** Arrow keys move between options (roving tabindex), as in VS Code's onboarding. */
+	protected setupRadioGroupNavigation(items: HTMLElement[], selectedIndex: number): void {
+		for (let i = 0; i < items.length; i++) {
+			items[i].setAttribute('tabindex', i === selectedIndex ? '0' : '-1');
+			this.pageDisposables.add(addDisposableListener(items[i], EventType.KEY_DOWN, (e: KeyboardEvent) => {
+				const event = new StandardKeyboardEvent(e);
+				let next: number | undefined;
+				if (event.keyCode === KeyCode.RightArrow || event.keyCode === KeyCode.DownArrow) {
+					next = (i + 1) % items.length;
+				} else if (event.keyCode === KeyCode.LeftArrow || event.keyCode === KeyCode.UpArrow) {
+					next = (i - 1 + items.length) % items.length;
+				} else if (event.keyCode === KeyCode.Home) {
+					next = 0;
+				} else if (event.keyCode === KeyCode.End) {
+					next = items.length - 1;
+				}
+				if (next !== undefined) {
+					e.preventDefault();
+					e.stopPropagation();
+					items[i].setAttribute('tabindex', '-1');
+					items[next].setAttribute('tabindex', '0');
+					items[next].focus();
+					items[next].click();
+				}
+			}));
+		}
+	}
