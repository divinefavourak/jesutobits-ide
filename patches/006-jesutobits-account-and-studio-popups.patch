+			return;
+		}
+		const first = focusable[0];
+		const last = focusable[focusable.length - 1];
+		const active = getActiveWindow().document.activeElement;
+		if (shiftKey && active === first) {
+			e.preventDefault();
+			last.focus();
+		} else if (!shiftKey && active === last) {
+			e.preventDefault();
+			first.focus();
+		}
+	}
