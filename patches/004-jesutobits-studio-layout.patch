diff --git a/src/vs/workbench/browser/parts/editor/jesutobitsGreeting.ts b/src/vs/workbench/browser/parts/editor/jesutobitsGreeting.ts
new file mode 100644
index 0000000..6e46b8a
--- /dev/null
+++ b/src/vs/workbench/browser/parts/editor/jesutobitsGreeting.ts
@@ -0,0 +1,95 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Jesutobits. Licensed under the MIT License.
+ *--------------------------------------------------------------------------------------------*/
+
+import './media/jesutobitsGreeting.css';
+import { $, append, clearNode } from '../../../../base/browser/dom.js';
+import { Emitter, Event } from '../../../../base/common/event.js';
+import { Disposable } from '../../../../base/common/lifecycle.js';
+import { Codicon } from '../../../../base/common/codicons.js';
+import { renderIcon } from '../../../../base/browser/ui/iconLabel/iconLabels.js';
+import { localize } from '../../../../nls.js';
+import { IConfigurationService } from '../../../../platform/configuration/common/configuration.js';
+import { Extensions as ConfigurationExtensions, IConfigurationRegistry } from '../../../../platform/configuration/common/configurationRegistry.js';
+import { Registry } from '../../../../platform/registry/common/platform.js';
+import { IWorkspaceContextService } from '../../../../platform/workspace/common/workspace.js';
+
+/**
+ * Jesutobits: the Studio greeting above the main editor area (patch 004), as in the design's
+ * middle column: "See what you're building." with the open project's name.
+ */
+
+const GREETING_SETTING = 'workbench.jesutobits.greeting';
+
+/** Fixed, so the editor below never shifts while the window lays out. */
+const GREETING_HEIGHT = 64;
+
+Registry.as<IConfigurationRegistry>(ConfigurationExtensions.Configuration).registerConfiguration({
+	id: 'jesutobits',
+	title: localize('jesutobits.configuration', "Jesutobits"),
+	type: 'object',
+	properties: {
+		[GREETING_SETTING]: {
+			type: 'boolean',
+			default: true,
+			description: localize('jesutobits.greeting', "Show the Studio greeting (\"See what you're building.\") above the editor."),
+		},
+	},
+});
+
+export class JesutobitsGreeting extends Disposable {
+
+	readonly element: HTMLElement;
+	private readonly badge: HTMLElement;
+
+	private readonly _onDidChangeHeight = this._register(new Emitter<void>());
+	readonly onDidChangeHeight: Event<void> = this._onDidChangeHeight.event;
+
+	constructor(
+		@IConfigurationService private readonly configurationService: IConfigurationService,
+		@IWorkspaceContextService private readonly workspaceContextService: IWorkspaceContextService,
+	) {
+		super();
+
+		this.element = $('.jesutobits-greeting');
+		this.element.style.height = `${GREETING_HEIGHT}px`;
+
+		const text = append(this.element, $('.jesutobits-greeting-text'));
+		append(text, $('.jesutobits-greeting-eyebrow')).textContent = localize('jesutobits.greeting.eyebrow', "A LITTLE IDEA, COMING TO LIFE");
+		const title = append(text, $('h1.jesutobits-greeting-title'));
+		title.append(localize('jesutobits.greeting.title', "See what you're building"));
+		append(title, $('span.jesutobits-greeting-dot')).textContent = '.';
+
+		this.badge = append(this.element, $('.jesutobits-greeting-badge'));
+		this.renderBadge();
+
+		this._register(this.workspaceContextService.onDidChangeWorkspaceFolders(() => this.renderBadge()));
+		this._register(this.workspaceContextService.onDidChangeWorkbenchState(() => this.renderBadge()));
+		this._register(this.configurationService.onDidChangeConfiguration(e => {
+			if (e.affectsConfiguration(GREETING_SETTING)) {
+				this.element.style.display = this.visible ? '' : 'none';
+				this._onDidChangeHeight.fire();
+			}
+		}));
+		this.element.style.display = this.visible ? '' : 'none';
+	}
+
+	private get visible(): boolean {
+		return this.configurationService.getValue<boolean>(GREETING_SETTING) !== false;
+	}
+
+	/** The space the greeting takes from the editor area. */
+	get height(): number {
+		return this.visible ? GREETING_HEIGHT : 0;
+	}
+
+	/** The open project's name, or a gentle nudge when nothing is open. */
+	private renderBadge(): void {
+		clearNode(this.badge);
+		const folder = this.workspaceContextService.getWorkspace().folders[0];
+		this.badge.appendChild(renderIcon(folder ? Codicon.folder : Codicon.sparkle));
+		append(this.badge, $('span')).textContent = folder
+			? folder.name
+			: localize('jesutobits.greeting.noProject', "Your next idea");
+	}
+}
diff --git a/src/vs/workbench/browser/parts/editor/media/jesutobitsGreeting.css b/src/vs/workbench/browser/parts/editor/media/jesutobitsGreeting.css
new file mode 100644
index 0000000..da2361c
--- /dev/null
+++ b/src/vs/workbench/browser/parts/editor/media/jesutobitsGreeting.css
@@ -0,0 +1,66 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Jesutobits. Licensed under the MIT License.
+ *--------------------------------------------------------------------------------------------*/
+
+/* The Studio greeting above the main editor area (jesutobitsGreeting.ts). Theme colours only;
+   a fixed height, so nothing below it moves. */
+.monaco-workbench .part.editor > .content .jesutobits-greeting,
+.monaco-workbench .part.editor .jesutobits-greeting {
+	display: flex;
+	align-items: center;
+	justify-content: space-between;
+	gap: 16px;
+	box-sizing: border-box;
+	padding: 0 24px;
+	overflow: hidden;
+	background: var(--vscode-editor-background);
+	color: var(--vscode-foreground);
+	user-select: none;
+}
+
+.jesutobits-greeting-text {
+	display: flex;
+	flex-direction: column;
+	gap: 2px;
+	min-width: 0;
+}
+
+.jesutobits-greeting-eyebrow {
+	font-size: 10px;
+	font-weight: 600;
+	letter-spacing: 0.12em;
+	color: var(--vscode-descriptionForeground);
+}
+
+.jesutobits-greeting-title {
+	margin: 0;
+	font-size: 20px;
+	font-weight: 600;
+	line-height: 1.2;
+	white-space: nowrap;
+	overflow: hidden;
+	text-overflow: ellipsis;
+}
+
+.jesutobits-greeting-dot {
+	color: var(--vscode-textLink-foreground);
+}
+
+.jesutobits-greeting-badge {
+	display: flex;
+	align-items: center;
+	gap: 6px;
+	flex-shrink: 0;
+	max-width: 40%;
+	padding: 4px 10px;
+	border-radius: 999px;
+	font-size: 12px;
+	color: var(--vscode-textLink-foreground);
+	background: color-mix(in srgb, var(--vscode-textLink-foreground) 12%, transparent);
+}
+
+.jesutobits-greeting-badge > span {
+	overflow: hidden;
+	text-overflow: ellipsis;
+	white-space: nowrap;
+}
