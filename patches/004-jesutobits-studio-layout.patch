+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Jesutobits. Licensed under the MIT License.
+ *--------------------------------------------------------------------------------------------*/
+
+import { Codicon } from '../../../../base/common/codicons.js';
+import { localize2 } from '../../../../nls.js';
+import { Action2, MenuId, registerAction2 } from '../../../../platform/actions/common/actions.js';
+import { ICommandService } from '../../../../platform/commands/common/commands.js';
+import { ServicesAccessor } from '../../../../platform/instantiation/common/instantiation.js';
+import { TitleBarLeadingActionsGroup } from '../../../browser/parts/titlebar/titlebarActions.js';
+import { IOnboardingService } from '../common/onboardingService.js';
+
+/**
+ * Jesutobits: the Studio design's top-bar buttons (patch 004), in the title bar before the
+ * layout controls: Get Started (the welcome popup), New Project and Change the Look (the
+ * Jesutobits extension's commands).
+ */
+
+registerAction2(class extends Action2 {
+	constructor() {
+		super({
+			id: 'jesutobits.titleBar.getStarted',
+			title: localize2('jesutobits.titleBar.getStarted', "Get Started"),
+			icon: Codicon.book,
+			menu: { id: MenuId.TitleBar, group: TitleBarLeadingActionsGroup, order: 1 },
+		});
+	}
+
+	run(accessor: ServicesAccessor): void {
+		accessor.get(IOnboardingService).show();
+	}
+});
+
+registerAction2(class extends Action2 {
+	constructor() {
+		super({
+			id: 'jesutobits.titleBar.newProject',
+			title: localize2('jesutobits.titleBar.newProject', "New Project"),
+			icon: Codicon.newFolder,
+			menu: { id: MenuId.TitleBar, group: TitleBarLeadingActionsGroup, order: 2 },
+		});
+	}
+
+	async run(accessor: ServicesAccessor): Promise<void> {
+		await accessor.get(ICommandService).executeCommand('jesutobits.newProject');
+	}
+});
+
+registerAction2(class extends Action2 {
+	constructor() {
+		super({
+			id: 'jesutobits.titleBar.changeLook',
+			title: localize2('jesutobits.titleBar.changeLook', "Themes"),
+			icon: Codicon.symbolColor,
+			menu: { id: MenuId.TitleBar, group: TitleBarLeadingActionsGroup, order: 3 },
+		});
+	}
+
+	async run(accessor: ServicesAccessor): Promise<void> {
+		await accessor.get(ICommandService).executeCommand('jesutobits.changeLook');
+	}
+});
